datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

enum ProjectStatus {
  ACTIVE
  PAUSED
  COMPLETED
}

model Intention {
  id        String   @id @default(uuid())
  userId    String
  name      String
  color     String?
  isSystem  Boolean  @default(false) // true for the automatic "Journal" intention
  createdAt DateTime @default(now())

  projects        ProjectIntention[]
  events          EventIntention[]
  workoutRoutines   WorkoutRoutine[]
  savedMeals        SavedMeal[]
  dopamineMenuItems DopamineMenuItem[]

  @@index([userId])
}

model Project {
  id          String        @id @default(uuid())
  userId      String
  title       String
  endGoal     String
  dueDate     DateTime?
  status      ProjectStatus @default(ACTIVE)
  completedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  tasks      ProjectTask[]
  intentions ProjectIntention[]
  events     CalendarEvent[]

  @@index([userId])
}

model ProjectTask {
  id          String    @id @default(uuid())
  projectId   String
  text        String
  done        Boolean   @default(false)
  order       Int
  createdAt   DateTime  @default(now())
  completedAt DateTime?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model ProjectIntention {
  projectId   String
  intentionId String

  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  intention Intention @relation(fields: [intentionId], references: [id], onDelete: Cascade)

  @@id([projectId, intentionId])
  @@index([intentionId])
}

model CalendarEvent {
  id            String    @id @default(uuid())
  userId        String
  title         String
  startAt       DateTime?
  endAt         DateTime?
  isAllDay      Boolean   @default(false)
  location      String?
  notes         String?
  projectId     String?
  // The zone the times were entered in (as in Google Calendar), so the edit
  // form can show them that way again. startAt/endAt are still stored in the
  // user's main zone. Null = entered in the main zone.
  timeZone      String?
  // Google Calendar sync: the matching Google event, the version tag Google
  // gave it when we last saw it (it changes whenever the event is edited in
  // Google), and when the two were last made identical. An event edited in
  // the app since then has updatedAt > lastSyncedAt.
  googleEventId String?   @unique
  googleEtag    String?
  lastSyncedAt  DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  project      Project?         @relation(fields: [projectId], references: [id], onDelete: SetNull)
  intentions   EventIntention[]
  journalEntry JournalEntry?

  @@index([userId])
  @@index([projectId])
}

model EventIntention {
  eventId     String
  intentionId String

  event     CalendarEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  intention Intention     @relation(fields: [intentionId], references: [id], onDelete: Cascade)

  @@id([eventId, intentionId])
  @@index([intentionId])
}

model Journal {
  id        String   @id @default(uuid())
  userId    String
  name      String
  createdAt DateTime @default(now())

  prompts  JournalPrompt[]
  entries  JournalEntry[]
  schedule JournalSchedule?

  @@index([userId])
}

// A journal's repeating writing time ("Gratitude journal time"), e.g. Mon,
// Wed and Fri at 9:00pm for 20 minutes. It isn't stored as one event per
// day: the calendar works out each week's times from it, and Google gets it
// as one repeating event.
model JournalSchedule {
  id              String    @id @default(uuid())
  userId          String
  journalId       String    @unique
  // The days it repeats on, 1 = Monday ... 7 = Sunday.
  weekdays        Int[]
  // Start time on the user's wall clock, as minutes after midnight (21:00 = 1260).
  startMinutes    Int
  durationMinutes Int
  // The repeating event in Google, once sent. The sync sends it again when
  // updatedAt has moved past lastSyncedAt (the schedule was changed).
  googleEventId   String?   @unique
  lastSyncedAt    DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  journal Journal @relation(fields: [journalId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model JournalPrompt {
  id        String   @id @default(uuid())
  journalId String
  text      String
  createdAt DateTime @default(now())

  journal Journal @relation(fields: [journalId], references: [id], onDelete: Cascade)

  @@index([journalId])
}

model JournalEntry {
  id              String   @id @default(uuid())
  userId          String
  journalId       String
  calendarEventId String   @unique
  promptText      String?
  content         String?
  mediaUrls       String[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  journal Journal       @relation(fields: [journalId], references: [id], onDelete: Cascade)
  event   CalendarEvent @relation(fields: [calendarEventId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([journalId])
}

model QuickList {
  id        String   @id @default(uuid())
  userId    String
  name      String
  createdAt DateTime @default(now())

  items QuickListItem[]

  @@index([userId])
}

model QuickListItem {
  id          String    @id @default(uuid())
  quickListId String
  text        String
  done        Boolean   @default(false)
  createdAt   DateTime  @default(now())
  doneAt      DateTime?

  quickList QuickList @relation(fields: [quickListId], references: [id], onDelete: Cascade)

  @@index([quickListId])
}

model PostIt {
  id        String   @id @default(uuid())
  userId    String
  text      String
  order     Int      @default(0)
  createdAt DateTime @default(now())

  @@index([userId])
}

model Exercise {
  id           String   @id @default(uuid())
  userId       String
  name         String
  videoUrl     String
  startSeconds Int?
  endSeconds   Int?
  createdAt    DateTime @default(now())

  routineLinks WorkoutRoutineExercise[]

  @@index([userId])
}

model WorkoutRoutine {
  id                 String   @id @default(uuid())
  userId             String
  name               String
  defaultIntentionId String?
  createdAt          DateTime @default(now())

  defaultIntention Intention?               @relation(fields: [defaultIntentionId], references: [id], onDelete: SetNull)
  exercises        WorkoutRoutineExercise[]

  @@index([userId])
}

model WorkoutRoutineExercise {
  id         String @id @default(uuid())
  routineId  String
  exerciseId String
  order      Int

  routine  WorkoutRoutine @relation(fields: [routineId], references: [id], onDelete: Cascade)
  exercise Exercise       @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@index([routineId])
  @@index([exerciseId])
}

model SavedMeal {
  id                 String   @id @default(uuid())
  userId             String
  name               String
  note               String?
  defaultIntentionId String?
  createdAt          DateTime @default(now())

  defaultIntention Intention? @relation(fields: [defaultIntentionId], references: [id], onDelete: SetNull)

  @@index([userId])
}

model DopamineMenuItem {
  id          String   @id @default(uuid())
  userId      String
  text        String
  // Events made from this item (Schedule or Start now) count toward this
  // intention. Deleting the intention just untags the item.
  intentionId String?
  createdAt   DateTime @default(now())

  intention Intention? @relation(fields: [intentionId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([intentionId])
}

model Affirmation {
  id        String   @id @default(uuid())
  userId    String
  text      String
  createdAt DateTime @default(now())

  @@index([userId])
}

// One row per user: an affirmation the user wrote or picked to show instead
// of a random one from their permanent Affirmation pool (it isn't added to
// the pool). It shows through keepUntil, a calendar day in the user's time
// zone (stored as midnight UTC); null keeps it until the user changes it.
model TodayAffirmation {
  userId    String    @id
  text      String
  setAt     DateTime  @default(now())
  keepUntil DateTime? @db.Date
}

// One row per user: which sidebar panels they've hidden from the dashboard.
// A missing row means nothing is hidden.
model DashboardPreferences {
  userId       String   @id
  hiddenPanels String[] @default([])
  panelOrder   String[] @default([])
}

// One row per user: account-level settings not tied to any one feature.
// A missing row (or a null field) means "not set yet".
model UserSettings {
  userId         String   @id
  timezone       String?
  // Extra zones shown beside the week view's hour labels, in display order.
  extraTimezones String[] @default([])
  // false = "9 AM" (am/pm), true = "09:00" (24-hour / military time).
  use24HourClock Boolean  @default(false)
}

// One row per user who connected Google Calendar. The refresh token is the
// long-lived key Google hands out once at connect time; the access token is
// the short-lived (about an hour) key actually sent with each request, kept
// here so every page load doesn't have to ask Google for a new one.
model GoogleConnection {
  userId               String   @id
  refreshToken         String
  accessToken          String
  accessTokenExpiresAt DateTime
  connectedAt          DateTime @default(now())
}

// An event deleted in the app that still has to be deleted in Google. The
// next sync deletes it there, then removes this row. Kept as its own table
// because the CalendarEvent row itself is already gone.
model GoogleEventDeletion {
  googleEventId String   @id
  userId        String
  createdAt     DateTime @default(now())

  @@index([userId])
}
