DATABASE_URL="postgresql://postgres:[PASSWORD]@[PROJECT-REF].supabase.co:5432/postgres"
DATABASE_URL_POOLED="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@[POOLER-HOST]:6543/postgres"

# From Supabase dashboard: Project Settings > Data API
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="[PUBLISHABLE-KEY]"

# This app's own URL — used to build the password-reset email link.
# Also needs adding to Supabase dashboard: Authentication > URL Configuration > Redirect URLs
# as "[NEXT_PUBLIC_SITE_URL]/auth/confirm"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
